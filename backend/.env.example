# PostgreSQL connection string (async, used by SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://htr_user:htr_password@localhost:5432/htr_db

# Sync URL used only by Alembic-style / setup scripts if needed
DATABASE_URL_SYNC=postgresql+psycopg2://htr_user:htr_password@localhost:5432/htr_db

# HuggingFace model IDs (override to swap models without code changes)
TROCR_MODEL_ID=microsoft/trocr-base-handwritten
GRAMMAR_MODEL_ID=vennify/t5-base-grammar-correction

# Device: "cuda" if a GPU is available, otherwise "cpu"
DEVICE=cpu

# Where uploaded page images / camera captures are stored on disk
UPLOAD_DIR=./uploads

# Confidence threshold below which a node is flagged for manual review
LOW_CONFIDENCE_THRESHOLD=0.55

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173
